          "name": "Retrieve Calendar Entries",
          "request": {
            "name": "Retrieve Calendar Entries",
            "description": {
              "content": "Retrieves calendar entries for specific `ids` within the requested time span.\nThe time span is defined by the `start_after` and `end_before` query parameters.\nEnsure to provide valid date-time formats for these parameters.\n\nIf successful, returns additional entries in the requested time span.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "calendar"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "For localization the base path may have to be extended by the language. (This can only be one of ,en/)",
                  "type": "any",
                  "value": "{{language}}",
                  "key": "language"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"<string>\"\n  ],\n  \"start_after\": \"<dateTime>\",\n  \"end_before\": \"<dateTime>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
